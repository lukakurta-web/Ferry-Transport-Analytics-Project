GO

USE TransportAnalytics;               
GO


------------------------------------------
--         Creating Schemas             --
------------------------------------------
CREATE SCHEMA bronze;
GO
CREATE SCHEMA silver;
GO
CREATE SCHEMA gold;
GO


------------------------------------------
--         Testing Schemas              --
------------------------------------------
SELECT name
FROM sys.schemas
WHERE name IN ('bronze', 'silver', 'gold');
